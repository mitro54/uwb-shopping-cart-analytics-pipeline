# ==============================================================================
# ByteBuddies Configuration Template
# Use this file to configure the system for your specific shop and environment.
# Copy this to '.env' and fill in your values.
# ==============================================================================

# --- DATABASE SETTINGS ---
# Path to the DuckDB file. Relative to project root.
DUCKDB_PATH="data/warehouse/dev.duckdb"

# --- LOCALIZATION & IDENTITY ---
# The name of your shop as it will appear in the dashboard titles and headers.
STORE_NAME="ByteBuddies Paris"

# Timezone used for all data transformations and dashboard displays (e.g., Europe/Paris, America/New_York).
APP_TIMEZONE="Europe/Paris"

# Locale for number and date formatting (e.g., fi_FI, fr_FR, en_US).
APP_LOCALE="fr_FR"

# --- LLM & AGENT SETTINGS ---
# API Key for Google Gemini (required if local Ollama is not used).
GEMINI_API_KEY="your-gemini-api-key-here"

# Base URL for local Ollama API (usually http://localhost:11434).
OLLAMA_BASE_URL="http://localhost:11434"

# Models used for different agent roles. Can be Ollama model names or Gemini model names.
ORCHESTRATOR_MODEL="qwen2.5:3b"
ANALYTICS_MODEL="qwen3.5:35b"
PLOTTER_MODEL="qwen3.5:9b"
SCHEMA_MODEL="qwen2.5:3b"
EMBEDDING_MODEL="nomic-embed-text:latest"

# Maximum number of steps an agent can take to solve a complex query.
AGENT_MAX_ITERATIONS=25

# Enable/disable detailed debug logging for agent actions.
AGENT_VERBOSE=true

# --- PHYSICAL STORE LAYOUT (METERS) ---
# Maximum dimensions of your shop floor in meters.
STORE_WIDTH_M=100.00
STORE_HEIGHT_M=50.00

# Path to the PNG/JPG image of your floorplan (relative to project root).
FLOORPLAN_IMAGE_PATH="image/your_floorplan.png"

# --- OPERATIONAL SETTINGS ---
# Standard opening and closing hours. Data outside these hours is filtered out in some views.
SHOP_OPEN_HOUR=8
SHOP_CLOSE_HOUR=21

# --- GEOFENCING (METERS) ---
# Defines the coordinates of the checkout area. 
# Used by the dbt pipeline to identify when a shopping session has ended.
CHECKOUT_X_MIN=0.0
CHECKOUT_X_MAX=10.0
CHECKOUT_Y_MIN=40.0
CHECKOUT_Y_MAX=50.0

# --- EXCLUSION ZONES (JSON) ---
# A JSON list of areas to be filtered out from the raw data (e.g., charging stations, storage rooms).
# Each zone requires x_min, x_max, y_min, y_max in meters.
# Format: '[{"x_min": 0, "x_max": 5, "y_min": 0, "y_max": 5}, ...]'
EXCLUDED_ZONES_JSON='[]'